---
import { loadData, statusLabel, fmtDate } from '../lib/data';
const { site, programs, gala, testimonials, news } = await loadData();
const r = site.registration; const g = gala.data; const gBody = gala.body;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); const logo = base + site.logo;
---
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VNHV Direction A — Evolutionary Refresh</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap">
<style is:global>
:root{
  --charcoal:#1F3A5F; --charcoal-2:#24446F; --gold:#E0A400; --gold-deep:#8A6200; --ink:#1B2F4B; --ink-2:#4E607A;
  --cream:#FBFAF7; --paper:#FFFFFF; --line:#E4DFD3; --green:#2E7D4F; --red:#A3282A; --focus:#1D4ED8;
  --font:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box}
html{color-scheme:light}
body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.6}
body.in-frame .proto{display:none}
img{max-width:100%;display:block}
a{color:var(--gold-deep)}
:focus-visible{outline:3px solid var(--focus);outline-offset:3px;border-radius:4px}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:#fff;padding:.6rem 1rem;z-index:100}
.skip:focus{left:8px}
.wrap{width:min(1180px,100% - 2rem);margin-inline:auto}
h1,h2,h3{line-height:1.2;text-wrap:balance;margin:0}
h2{font-size:clamp(1.5rem,1.2rem + 1.4vw,2.1rem);font-weight:700}
.eyebrow{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--gold-deep)}
.btn{display:inline-flex;align-items:center;gap:.5rem;white-space:nowrap;min-height:48px;padding:.75rem 1.4rem;border-radius:6px;font-weight:700;text-decoration:none;border:2px solid transparent;cursor:pointer;font:inherit;font-weight:700;transition:background .15s,transform .15s}
.btn-primary{background:var(--gold);color:#14273F}
.btn-primary:hover{background:#F2B400;transform:translateY(-1px)}
.btn-primary:active{transform:translateY(0);background:#CC9500}
.btn-dark{background:var(--green);color:#fff}
.btn-dark:hover{background:#256A42}
.btn-outline{border-color:var(--charcoal);color:var(--charcoal);background:transparent}
.btn-outline:hover{background:var(--charcoal);color:#fff}
.btn-outline-light{border-color:#fff;color:#fff;background:transparent}
.btn-outline-light:hover{background:#fff;color:var(--charcoal)}
.btn[aria-disabled="true"]{opacity:.5;cursor:not-allowed;transform:none}
/* utility bar + header */
.util{background:#14273F;color:#DCE4EE;font-size:.85rem}
.util .wrap{display:flex;justify-content:space-between;align-items:center;min-height:38px;gap:1rem;flex-wrap:wrap}
.util a{color:#fff;text-decoration:none}
.util .lang a[aria-current]{color:var(--gold);font-weight:700}
.util .lang a+a{margin-left:.6rem;padding-left:.6rem;border-left:1px solid #3A5A85}
header.site{background:var(--charcoal-2);color:#fff;position:sticky;top:0;z-index:80;box-shadow:0 2px 0 var(--gold)}
header.site .wrap{display:flex;align-items:center;gap:1.5rem;min-height:72px}
.logo img{height:44px;width:auto}
nav.primary{margin-left:auto}
nav.primary ul{list-style:none;margin:0;padding:0;display:flex;gap:.25rem}
nav.primary a,nav.primary button{color:#fff;text-decoration:none;font-weight:600;font-size:.95rem;padding:.6rem .75rem;border-radius:4px;background:none;border:0;font:inherit;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.3rem}
nav.primary a:hover,nav.primary button:hover{background:#2F5384;color:#F2C14E}
nav.primary li{position:relative}
nav.primary > ul > li > a,nav.primary > ul > li > button{white-space:nowrap}
nav.primary .sub{display:none;position:absolute;top:100%;left:0;background:#fff;color:var(--ink);min-width:240px;padding:.5rem;border-radius:6px;box-shadow:0 12px 30px rgba(20,39,63,.25);list-style:none;margin:0}
nav.primary li:hover>.sub,nav.primary li:focus-within>.sub{display:block}
nav.primary .sub a{color:var(--ink);display:block;font-weight:500}
nav.primary .sub a:hover{background:var(--cream);color:var(--gold-deep)}
.header-cta{display:flex;gap:.5rem}
.menu-toggle{display:none;margin-left:auto;background:none;border:2px solid #fff;color:#fff;border-radius:6px;min-width:48px;min-height:48px;font:inherit;font-weight:700;cursor:pointer}
/* hero */
.hero{position:relative;background:var(--charcoal);color:#fff;isolation:isolate}
.hero .photo{position:absolute;inset:0;background:linear-gradient(115deg,#1F3A5F 0%,#2F5A6A 55%,#3E7A57 100%);z-index:-2}
.hero .photo::after{content:"[PLACEHOLDER: ảnh lớp học thật · 1600×900 WebP · cần có giấy đồng ý của phụ huynh]";position:absolute;right:1rem;bottom:1rem;font-size:.75rem;background:rgba(20,39,63,.7);padding:.3rem .6rem;border-radius:4px;color:#fff}
.hero .scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,39,63,.94) 0%,rgba(20,39,63,.78) 45%,rgba(20,39,63,.3) 100%);z-index:-1}
.hero .wrap{padding:clamp(3rem,7vw,5.5rem) 0 3rem;max-width:1180px}
.hero h1{font-size:clamp(2rem,1.4rem + 3vw,3.4rem);font-weight:800;max-width:16ch}
.hero h1 span{color:#F2C14E}
.hero p.lead{font-size:1.15rem;max-width:52ch;margin:1rem 0 1.5rem;color:#EEE8DA}
.hero .actions{display:flex;gap:.75rem;flex-wrap:wrap}
.facts{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1.75rem;font-size:.95rem;color:#F3EDDF}
.facts span::before{content:"●";color:#F2C14E;margin-right:.5rem;font-size:.6rem;vertical-align:middle}
/* quick links */
.quick{background:var(--paper);border-bottom:1px solid var(--line)}
.quick ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,1fr)}
.quick a{display:flex;flex-direction:column;align-items:center;gap:.4rem;padding:1.1rem .5rem;text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem;border-right:1px solid var(--line);min-height:44px}
.quick li:last-child a{border-right:0}
.quick a:hover{background:var(--cream);color:var(--green)}
.quick .ic{width:36px;height:36px;border-radius:50%;background:var(--green);display:grid;place-items:center;color:#fff;font-weight:800;font-size:.9rem}
/* sections */
section{padding:clamp(2.5rem,6vw,4.5rem) 0}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.75rem;flex-wrap:wrap}
.sec-head p{margin:.35rem 0 0;color:var(--ink-2);max-width:60ch}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
.card{background:var(--paper);border:1px solid var(--line);border-radius:8px;overflow:hidden;display:flex;flex-direction:column}
.card .ph{aspect-ratio:3/2;background:linear-gradient(135deg,#E9E2CF,#D6CBAA);display:grid;place-items:center;color:#6B5A2E;font-size:.8rem;text-align:center;padding:1rem}
.card .body{padding:1.25rem;display:flex;flex-direction:column;gap:.6rem;flex:1}
.card h3{font-size:1.2rem}
.card .meta{font-size:.9rem;color:var(--ink-2)}
.card .body a.more{margin-top:auto;font-weight:700;text-decoration:none}
.card .body a.more:hover{text-decoration:underline}
/* announcement */
.notice{background:var(--paper);border-left:6px solid var(--green);padding:1.25rem 1.5rem;border-radius:0 8px 8px 0;display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;box-shadow:0 1px 0 var(--line)}
.notice strong{display:block;font-size:1.1rem}
/* stats */
.stats{background:var(--charcoal);color:#fff}
.stats ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;text-align:center}
.stats b{display:block;font-size:2.6rem;font-weight:800;color:var(--gold);font-variant-numeric:tabular-nums;line-height:1}
.stats span{font-size:.85rem;letter-spacing:.1em;text-transform:uppercase}
/* gala */
.gala{background:var(--paper);border:1px solid var(--line);border-radius:8px;display:grid;grid-template-columns:1.1fr 1fr;overflow:hidden}
.gala .ph{background:linear-gradient(160deg,#14273F,#1F3A5F 55%,#5a4210);color:#fff;display:grid;place-items:center;padding:2rem;text-align:center;min-height:260px}
.gala .ph small{opacity:.8;font-size:.75rem}
.gala .body{padding:2rem;display:flex;flex-direction:column;gap:.75rem}
.gala dl{display:grid;grid-template-columns:auto 1fr;gap:.25rem 1rem;margin:0}
.gala dt{font-weight:700;color:var(--ink-2)}.gala dd{margin:0}
/* testimonials */
.quote{background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:1.5rem;display:flex;flex-direction:column;gap:.75rem}
.quote p{margin:0;font-size:1.05rem}
.quote footer{display:flex;align-items:center;gap:.75rem;font-size:.9rem;color:var(--ink-2)}
.quote .avatar{width:44px;height:44px;border-radius:50%;background:var(--green)}
.principal{display:grid;grid-template-columns:auto 1fr;gap:1.5rem;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:1.5rem;margin-top:1.25rem}
.principal .ph{width:120px;height:150px;background:#DCD3BD;border-radius:6px;display:grid;place-items:center;font-size:.7rem;text-align:center;color:#6B5A2E}
/* cta band */
.band{background:var(--gold);color:#14273F}
.band .wrap{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;flex-wrap:wrap;padding:2rem 0}
.band h2{font-size:1.5rem}
/* footer */
footer.site{background:#14273F;color:#C9D3E0;font-size:.95rem}
footer.site .wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:2rem;padding:3rem 0 2rem}
footer.site h3{color:#fff;font-size:1rem;margin-bottom:.75rem;text-transform:uppercase;letter-spacing:.08em}
footer.site a{color:#fff}
footer.site ul{list-style:none;padding:0;margin:0;display:grid;gap:.4rem}
footer.site .legal{border-top:1px solid #3A5A85;padding:1rem 0;font-size:.85rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
/* forms */
.field{display:grid;gap:.35rem;margin-bottom:1rem}
.field label{font-weight:600}
.field input{font:inherit;padding:.7rem .8rem;border:2px solid #9A937F;border-radius:6px;min-height:48px;background:#fff}
.field input:focus{outline:3px solid var(--focus);outline-offset:2px;border-color:var(--ink)}
.field.error input{border-color:var(--red)}
.field .err{color:var(--red);font-size:.9rem;font-weight:600}
.field .hint{font-size:.85rem;color:var(--ink-2)}
/* proto tools */
.proto-bar{position:fixed;right:1rem;bottom:1rem;z-index:200;display:flex;gap:.5rem}
.proto-bar button{background:var(--ink);color:#fff;border:0;border-radius:999px;padding:.6rem 1rem;font:inherit;font-weight:600;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.25)}
.proto-panel{position:fixed;inset:0;background:rgba(27,36,49,.85);z-index:190;display:grid;place-items:center;padding:1rem}
.proto-panel[hidden]{display:none}
.proto-panel iframe{width:390px;height:min(820px,92vh);border:10px solid #14273F;border-radius:32px;background:#fff}
.proto-note{background:#FFF7DB;border:1px dashed var(--gold-deep);padding:.75rem 1rem;border-radius:6px;font-size:.9rem}
.states{background:var(--paper);border-top:4px solid var(--gold)}
.states .row{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:.75rem 0}
.swatches{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem}
.sw{border:1px solid var(--line);border-radius:6px;overflow:hidden;font-size:.8rem}
.sw div{height:56px}.sw p{margin:0;padding:.5rem}
.focus-demo{outline:3px solid var(--focus);outline-offset:3px}
/* responsive */
@media (max-width:960px){
  .grid-3{grid-template-columns:1fr 1fr}
  footer.site .wrap{grid-template-columns:1fr 1fr}
  .quick ul{grid-template-columns:repeat(3,1fr)}
  .quick a{border-bottom:1px solid var(--line)}
  .gala{grid-template-columns:1fr}
}
@media (max-width:1080px){
  .menu-toggle{display:inline-flex;align-items:center;justify-content:center}
  nav.primary{display:none;position:absolute;left:0;right:0;top:100%;background:var(--charcoal-2);padding:1rem;border-top:1px solid #3A5A85}
  nav.primary.open{display:block;height:calc(100dvh - 88px - 76px);max-height:calc(100dvh - 88px - 76px);overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding-bottom:1.5rem}
  nav.primary ul{flex-direction:column;gap:0}
  nav.primary a,nav.primary button{display:flex;padding:.9rem .75rem;font-size:1.05rem}
  nav.primary .sub{position:static;box-shadow:none;background:#2F5384;display:block;padding-left:1rem}
  nav.primary .sub a{color:#fff}
}
@media (max-width:720px){
  body{font-size:16px}
  .header-cta{display:none}
  .grid-3{grid-template-columns:1fr}
  .stats ul{grid-template-columns:1fr 1fr}
  .notice{grid-template-columns:1fr}
  footer.site .wrap{grid-template-columns:1fr}
  .principal{grid-template-columns:1fr}
  .hero h1{max-width:none}
  .sticky-cta{position:fixed;left:0;right:0;bottom:0;background:var(--charcoal);padding:.6rem 1rem;display:flex;gap:.5rem;z-index:60}
  .sticky-cta .btn{flex:1;justify-content:center}
  body{padding-bottom:76px}
}
@media (min-width:721px){.sticky-cta{display:none}}
@media (max-width:720px){.proto-bar{bottom:88px}}
body.menu-open .proto-bar{display:none!important}
body.menu-open{overflow:hidden}
.nav-backdrop{position:fixed;inset:0;background:rgba(20,39,63,.62);z-index:55;border:0;padding:0;margin:0;cursor:pointer}
.nav-backdrop[hidden]{display:none}
@media (min-width:1081px){.nav-backdrop{display:none!important}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.ph img,.photo img{width:100%;height:100%;object-fit:cover;display:block}
.has-img::after{display:none!important}
.pill-closed{background:#E6E1D6;color:#4E607A}
</style>
</head>
<body>
<a class="skip" href="#main">Bỏ qua đến nội dung chính</a>

<div class="util">
  <div class="wrap">
    <span>{site.hours} · {site.campus}, {site.address.split(",")[0]}, Houston · <a href={"tel:"+site.phoneTel}>{site.phone}</a></span>
    <span class="lang" aria-label="Ngôn ngữ"><a href="#" aria-current="true" lang="vi">Tiếng Việt</a><a href="#" lang="en">English</a></span>
  </div>
</div>

<header class="site">
  <div class="wrap">
    <a class="logo" href="#" aria-label="Trường Việt Ngữ Hùng Vương – trang nhà"><img src={logo} alt="" width="272" height="54"></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" onclick="toggleMenu(this)">☰ Menu</button>
    <nav class="primary" id="primary-nav" aria-label="Chính">
      <ul>
        <li><button aria-expanded="false">Giới thiệu ▾</button>
          <ul class="sub"><li><a href="#">Tổng quát &amp; lịch sử</a></li><li><a href="#">Ban Điều Hành</a></li><li><a href="#">Ban Giảng Huấn {r.year}</a></li><li><a href="#">Nội quy · Ca khúc</a></li></ul></li>
        <li><button aria-expanded="false">Chương trình ▾</button>
          <ul class="sub"><li><a href="#">Việt ngữ cấp 1</a></li><li><a href="#">Việt ngữ cấp 2</a></li><li><a href="#">Việt ngữ người lớn</a></li><li><a href="#">Tài liệu học</a></li></ul></li>
        <li><a href="#">Ghi danh</a></li>
        <li><button aria-expanded="false">Sinh hoạt ▾</button>
          <ul class="sub"><li><a href="#">Lịch trình {r.year}</a></li><li><a href="#">Sự kiện &amp; Tin tức</a></li><li><a href="#">Hình ảnh · Video</a></li><li><a href="#">Lịch sử &amp; Kỷ yếu (lưu trữ)</a></li></ul></li>
        <li><button aria-expanded="false">Cộng đồng ▾</button>
          <ul class="sub"><li><a href="#">Hội Phụ Huynh HS</a></li><li><a href="#">Tình nguyện · Phụ giáo</a></li><li><a href="#">Cựu học sinh</a></li></ul></li>
        <li><a href="#">Liên lạc</a></li>
        <li><a href="#">Hỗ trợ</a></li>
      </ul>
    </nav>
    <div class="header-cta"><a class="btn btn-primary" href="#">Ghi danh</a></div>
  </div>
</header>
<button class="nav-backdrop" id="navBackdrop" hidden aria-label="Đóng menu" onclick="closeMenu()"></button>

<main id="main">
<section class="hero" style="padding:0">
  <div class={"photo"+(site.heroImage?" has-img":"")} style={site.heroImage?`background-image:url(${base+site.heroImage});background-size:cover;background-position:center`:""}></div><div class="scrim"></div>
  <div class="wrap">
    <p class="eyebrow" style="color:#F2C14E">Thành lập năm 1986 · Houston, Texas</p>
    <h1>Trường Việt Ngữ <span>Hùng Vương</span></h1>
    <p class="lead">Lớp tiếng Việt và văn hoá Việt cho các em từ Mẫu giáo đến lớp 9 và cho người lớn — mỗi sáng Chủ nhật tại HCC Central. <span lang="en">Vietnamese language &amp; culture classes for children and adults in Houston.</span></p>
    <div class="actions">
      <a class="btn btn-primary" href="#">Ghi danh niên khóa {r.year}</a>
      <a class="btn btn-outline-light" href="#">Xem lịch trình</a>
    </div>
    <div class="facts"><span>Khai giảng {r.openingDay}</span><span>{site.hours}</span><span>HCC Central · {site.room}</span></div>
  </div>
</section>

<div class="quick">
  <div class="wrap">
    <ul>
      <li><a href="#"><span class="ic" aria-hidden="true">40</span>Kỷ niệm</a></li>
      <li><a href="#"><span class="ic" aria-hidden="true">SH</span>Sinh hoạt</a></li>
      <li><a href="#"><span class="ic" aria-hidden="true">LT</span>Lịch trình</a></li>
      <li><a href="#"><span class="ic" aria-hidden="true">HS</span>Học sinh cũ</a></li>
      <li><a href="#"><span class="ic" aria-hidden="true">?</span>Hỏi &amp; Trả lời</a></li>
      <li><a href="#"><span class="ic" aria-hidden="true">f</span>Facebook</a></li>
    </ul>
  </div>
</div>

<section style="padding-bottom:0">
  <div class="wrap">
    <div class="notice" role="region" aria-label="Thông báo">
      <div><span class="eyebrow">Thông báo</span><strong>Ghi danh sớm để được ưu tiên xếp lớp</strong>
        Học phí ${r.earlyPrice} nếu ghi danh trước 30/6 · ${r.latePrice} từ 1/7 đến 14/8 · Khai giảng {r.openingDay}. Học sinh cũ cần số danh bạ.
        <span lang="en" style="display:block;color:var(--ink-2);font-size:.95rem">Tuition ${r.earlyPrice} before June 30, ${r.latePrice} July 1–Aug 14. Opening day {r.openingDayEn}.</span></div>
      <a class="btn btn-dark" href="#">Cách ghi danh</a>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">Chương trình học</span><h2>Ba chương trình, một buổi sáng Chủ nhật</h2><p>Chương trình cấp 1 và cấp 2 dựa trên bộ "Tiếng Nước Tôi" và tài liệu do ban Tu Thư của trường biên soạn.</p></div><a href="#" class="btn btn-outline">Lớp nào phù hợp?</a></div>
    <div class="grid-3">
{programs.map(p => (<article class="card"><div class="ph">{p.data.image ? <img src={base+p.data.image} alt="" loading="lazy"/> : "[PLACEHOLDER ảnh " + p.data.title + "]"}</div><div class="body"><h3>{p.data.title}</h3><p class="meta">{p.data.meta}</p><p>{p.body}</p><a class="more" href="#">Xem chương trình →</a></div></article>))}
    </div>
  </div>
</section>

<div class="stats"><div class="wrap" style="padding:2.25rem 0"><ul>
  <li><b>{site.stats.students}</b><span>Học sinh</span></li><li><b>{site.stats.teachers}</b><span>Thầy cô</span></li><li><b>{site.stats.classes}</b><span>Lớp học</span></li><li><b>{site.stats.years}</b><span>Năm hoạt động</span></li></ul>
  <p style="text-align:center;font-size:.8rem;color:#B9C6D8;margin:1rem 0 0">Số liệu niên khóa {r.year} — cập nhật mỗi tháng 8 từ một bảng dữ kiện duy nhất.</p></div></div>

<section>
  <div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">Sự kiện sắp tới</span><h2>Dạ tiệc Kỷ niệm 40 năm</h2></div></div>
    <div class="gala">
