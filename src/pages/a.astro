</section>

<div class="proto-bar proto"><button type="button" onclick="toggleMobile()">📱 Xem bản mobile (390px)</button></div>
<div class="proto-panel proto" id="mobilePanel" hidden onclick="if(event.target===this)toggleMobile()"><iframe id="mobileFrame" title="Bản xem trước mobile"></iframe></div>

<script is:inline>
document.documentElement.lang='vi';
if(document.documentElement.hasAttribute('data-frame')){document.body.classList.add('in-frame')}
function toggleMenu(b){const n=document.getElementById('primary-nav');const o=n.classList.toggle('open');b.setAttribute('aria-expanded',o);document.body.classList.toggle('menu-open',o);document.getElementById('navBackdrop').hidden=!o}
function closeMenu(){const b=document.querySelector('.menu-toggle');if(document.getElementById('primary-nav').classList.contains('open'))toggleMenu(b)}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu()});
document.querySelectorAll('nav.primary > ul > li > button').forEach(b=>b.addEventListener('click',()=>{const e=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',!e);b.nextElementSibling.style.display=e?'':'block'}));
function toggleMobile(){const p=document.getElementById('mobilePanel');if(p.hidden){const html='<!doctype html><html lang="vi" data-frame="1">'+document.documentElement.innerHTML+'</html>';document.getElementById('mobileFrame').srcdoc=html;p.hidden=false}else{p.hidden=true}}
</script>

</body>
</html>
