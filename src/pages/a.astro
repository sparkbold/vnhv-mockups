    <div class="row" style="background:#24446F;padding:.5rem;border-radius:6px"><a href="#" style="color:#fff;font-weight:600;padding:.6rem .75rem;text-decoration:none">Mặc định</a><a href="#" style="color:#F2C14E;background:#2F5384;font-weight:600;padding:.6rem .75rem;border-radius:4px;text-decoration:none">Hover</a><a href="#" class="focus-demo" style="color:#fff;font-weight:600;padding:.6rem .75rem;text-decoration:none">Focus</a></div>
