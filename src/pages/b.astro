    <div class="row"><a class="btn btn-secondary" href="#">Phụ</a><a class="btn btn-secondary" href="#" style="background:#1F3A5F;color:#fff">Phụ · hover</a><a class="btn btn-ghost" href="#">Viền xanh</a><a class="btn btn-ghost focus-demo" href="#">Viền · focus</a></div>
