---
import { loadData, statusLabel, fmtDate } from '../lib/data';
const { site, programs, gala, testimonials, news } = await loadData();
const r = site.registration; const g = gala.data; const gBody = gala.body;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); const logo = base + site.logo;
---
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VNHV Direction B — Conversion-Focused</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:wght@600;700&display=swap">
<style is:global>
:root{
  --red:#2E7D4F; --red-hover:#256A42; --red-active:#1E5636; --ink:#1B2F4B; --ink-2:#4E607A; --navy:#1F3A5F; --gold:#8F6E2C; --gold-bg:#F4EBD3;
  --paper:#FBFAF7; --white:#FFFFFF; --line:#E1DBCD; --green:#2E7D4F; --green-bg:#E4F2EA; --focus:#1D4ED8; --dark:#14273F;
  --font:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --display:"Lora",Georgia,"Times New Roman",serif;
}
*{box-sizing:border-box}
html{color-scheme:light}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.6}
body.in-frame .proto{display:none}
img{max-width:100%;display:block}
a{color:var(--red)}
:focus-visible{outline:3px solid var(--focus);outline-offset:3px;border-radius:4px}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:#fff;padding:.6rem 1rem;z-index:100}.skip:focus{left:8px}
.wrap{width:min(1160px,100% - 2rem);margin-inline:auto}
h1,h2,h3{line-height:1.2;text-wrap:balance;margin:0}
h1{font-family:var(--display)} h2{font-family:var(--display);font-size:clamp(1.6rem,1.2rem + 1.6vw,2.25rem);font-weight:700}
.eyebrow{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--gold)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;white-space:nowrap;min-height:50px;padding:.75rem 1.5rem;border-radius:8px;font:inherit;font-weight:700;text-decoration:none;border:2px solid transparent;cursor:pointer;transition:background .15s,box-shadow .15s}
.btn-primary{background:var(--red);color:#fff}
.btn-primary:hover{background:var(--red-hover);box-shadow:0 6px 16px rgba(46,125,79,.3)}
.btn-primary:active{background:var(--red-active);box-shadow:none}
.btn-secondary{background:var(--white);color:var(--navy);border-color:var(--navy)}
.btn-secondary:hover{background:var(--navy);color:#fff}
.btn-ghost{background:transparent;color:var(--red);border-color:var(--red)}
.btn-ghost:hover{background:var(--red);color:#fff}
.btn[aria-disabled="true"]{background:#B9B3A6;color:#fff;cursor:not-allowed;box-shadow:none}
.pill{display:inline-block;padding:.2rem .6rem;border-radius:999px;font-size:.8rem;font-weight:700;letter-spacing:.02em}
.pill-open{background:var(--green-bg);color:var(--green)}
.pill-soon{background:var(--gold-bg);color:var(--gold)}
/* header */
.util{background:var(--dark);color:#E6E0D2;font-size:.85rem}
.util .wrap{display:flex;justify-content:space-between;align-items:center;min-height:40px;gap:1rem;flex-wrap:wrap}
.util a{color:#fff;text-decoration:none}.util a[aria-current]{color:#F2C14E;font-weight:700}
.util .lang a+a{margin-left:.6rem;padding-left:.6rem;border-left:1px solid #3A5A85}
header.site{background:var(--white);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:80}
header.site .wrap{display:flex;align-items:center;gap:1.25rem;min-height:76px}
.brand{display:flex;align-items:center;text-decoration:none;flex:none;min-width:0}
.brand .logo-bg{display:block;background:var(--dark);border-radius:8px;padding:.45rem .7rem}
.brand img{height:34px;width:auto}
.brand .mark{width:44px;height:44px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#F2C14E,#B8860B 70%);flex:none;display:grid;place-items:center;color:#14273F;font-weight:800;font-size:.75rem}
.brand b{display:block;font-family:var(--display);font-size:1.05rem;line-height:1.1}
.brand small{display:block;font-size:.72rem;color:var(--ink-2);letter-spacing:.04em}
nav.primary{margin-left:auto}
nav.primary ul{list-style:none;margin:0;padding:0;display:flex;gap:.1rem}
nav.primary a,nav.primary button{color:var(--ink);text-decoration:none;font-weight:600;font-size:.9rem;padding:.6rem .55rem;border-radius:6px;background:none;border:0;font:inherit;font-weight:600;cursor:pointer;display:inline-flex;gap:.3rem;align-items:center}
nav.primary a:hover,nav.primary button:hover{background:var(--paper);color:var(--red)}
nav.primary li{position:relative}
nav.primary > ul > li > a,nav.primary > ul > li > button{white-space:nowrap}
nav.primary .sub{display:none;position:absolute;top:100%;left:0;background:#fff;min-width:250px;padding:.5rem;border:1px solid var(--line);border-radius:8px;box-shadow:0 14px 30px rgba(20,39,63,.15);list-style:none;margin:0}
nav.primary li:hover>.sub,nav.primary li:focus-within>.sub{display:block}
nav.primary .sub a{display:block;font-weight:500}
.header-cta{display:flex;gap:.5rem}
.menu-toggle{display:none;margin-left:auto;background:none;border:2px solid var(--ink);color:var(--ink);border-radius:8px;min-width:48px;min-height:48px;font:inherit;font-weight:700;cursor:pointer}
/* hero */
.hero{background:var(--white);border-bottom:1px solid var(--line)}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:3rem;align-items:center;padding:clamp(2.5rem,6vw,4.5rem) 0}
.hero h1{font-size:clamp(2.1rem,1.4rem + 3vw,3.5rem);font-weight:700;max-width:18ch}
.hero h1 em{font-style:normal;color:var(--red)}
.hero .lead{font-size:1.15rem;color:var(--ink-2);max-width:50ch;margin:1rem 0 1.5rem}
.hero .actions{display:flex;gap:.75rem;flex-wrap:wrap}
.hero .photo{aspect-ratio:4/3;border-radius:14px;background:linear-gradient(140deg,#E9DFC4,#C9A961 60%,#8F6E2C);position:relative;overflow:hidden}
.hero .photo::after{content:"[PLACEHOLDER: ảnh thật học sinh trong lớp · 1200×900 WebP · cần giấy đồng ý sử dụng hình]";position:absolute;inset:auto 1rem 1rem;background:rgba(20,39,63,.7);color:#fff;font-size:.75rem;padding:.4rem .6rem;border-radius:6px}
.keyfacts{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:12px;background:var(--white);overflow:hidden;margin-top:-2rem;position:relative;z-index:2}
.keyfacts div{padding:1rem 1.25rem;border-right:1px solid var(--line)}
.keyfacts div:last-child{border-right:0}
.keyfacts span{display:block;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2);font-weight:700}
.keyfacts b{font-size:1.1rem;font-weight:700}
/* deadline */
.deadline{background:var(--gold-bg);border:1px solid #E5D5A8;border-radius:12px;padding:1.25rem 1.5rem;display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center}
.deadline ol{margin:.4rem 0 0;padding-left:1.2rem;display:grid;gap:.15rem}
.deadline li b{font-variant-numeric:tabular-nums}
section{padding:clamp(2.5rem,6vw,4.5rem) 0}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.75rem;flex-wrap:wrap}
.sec-head p{margin:.35rem 0 0;color:var(--ink-2);max-width:60ch}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
.card{background:var(--white);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;overflow:hidden;transition:box-shadow .15s,transform .15s}
.card:hover{box-shadow:0 10px 26px rgba(20,39,63,.1);transform:translateY(-2px)}
.card .ph{aspect-ratio:16/9;background:linear-gradient(135deg,#EFE7D2,#D8C9A0);display:grid;place-items:center;color:#6B5A2E;font-size:.8rem;text-align:center;padding:1rem}
.card .body{padding:1.25rem;display:flex;flex-direction:column;gap:.5rem;flex:1}
.card h3{font-size:1.2rem}
.card .meta{font-size:.9rem;color:var(--ink-2)}
.card ul{margin:0;padding-left:1.1rem;font-size:.95rem;color:var(--ink-2)}
.card .foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:.75rem}
.card .foot a{font-weight:700;text-decoration:none}.card .foot a:hover{text-decoration:underline}
/* steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;counter-reset:s}
.step{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:1.25rem;position:relative;counter-increment:s}
.step::before{content:counter(s);display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--red);color:#fff;font-weight:700;margin-bottom:.75rem}
.step h3{font-size:1.05rem;margin-bottom:.3rem}.step p{margin:0;font-size:.95rem;color:var(--ink-2)}
/* event */
.event{background:var(--navy);color:#fff;border-radius:14px;display:grid;grid-template-columns:auto 1fr auto;gap:2rem;align-items:center;padding:2rem}
.event .date{text-align:center;background:#fff;color:var(--ink);border-radius:10px;padding:.75rem 1rem;min-width:96px}
.event .date b{display:block;font-size:2rem;line-height:1;font-family:var(--display)}
.event .date span{font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;font-weight:700}
.event h3{font-family:var(--display);font-size:1.6rem}
.event p{margin:.35rem 0 0;color:#D6DEEA}
.event .price{color:#F2C14E;font-weight:700}
/* trust */
.trust{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
.trust div{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:1.25rem;text-align:center}
.trust b{display:block;font-size:2.2rem;font-family:var(--display);color:var(--navy);font-variant-numeric:tabular-nums;line-height:1.1}
.trust span{font-size:.9rem;color:var(--ink-2)}
.quote{background:var(--white);border:1px solid var(--line);border-radius:12px;padding:1.5rem;display:flex;flex-direction:column;gap:.75rem}
.quote p{margin:0;font-family:var(--display);font-size:1.1rem}
.quote footer{font-size:.9rem;color:var(--ink-2)}
/* dual CTA */
.dual{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}
.dual div{border-radius:12px;padding:2rem;display:flex;flex-direction:column;gap:.75rem}
.dual .give{background:var(--navy);color:#fff}
.dual .give a{background:#fff;color:var(--navy)}
.dual .vol{background:var(--white);border:1px solid var(--line)}
.dual h3{font-family:var(--display);font-size:1.5rem}
.dual p{margin:0}
/* footer */
footer.site{background:var(--dark);color:#C9D3E0;font-size:.95rem}
footer.site .wrap{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:2rem;padding:3rem 0 2rem}
footer.site h3{color:#fff;font-size:.85rem;margin-bottom:.75rem;text-transform:uppercase;letter-spacing:.1em}
footer.site a{color:#fff}
footer.site ul{list-style:none;padding:0;margin:0;display:grid;gap:.4rem}
footer.site .legal{border-top:1px solid #3A5A85;padding:1rem 0;font-size:.85rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
/* forms */
.field{display:grid;gap:.35rem;margin-bottom:1rem}
.field label{font-weight:600}
.field input,.field select{font:inherit;padding:.7rem .8rem;border:2px solid #8E8778;border-radius:8px;min-height:48px;background:#fff}
.field input:focus{outline:3px solid var(--focus);outline-offset:2px}
.field.error input{border-color:var(--red)}
.field .err{color:var(--red);font-size:.9rem;font-weight:600}
.field .hint{font-size:.85rem;color:var(--ink-2)}
/* proto */
.proto-bar{position:fixed;right:1rem;bottom:1rem;z-index:200}
.proto-bar button{background:var(--ink);color:#fff;border:0;border-radius:999px;padding:.6rem 1rem;font:inherit;font-weight:600;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.25)}
.proto-panel{position:fixed;inset:0;background:rgba(27,36,49,.85);z-index:190;display:grid;place-items:center;padding:1rem}
.proto-panel[hidden]{display:none}
.proto-panel iframe{width:390px;height:min(820px,92vh);border:10px solid #14273F;border-radius:32px;background:#fff}
.proto-note{background:#FFF7DB;border:1px dashed var(--gold);padding:.75rem 1rem;border-radius:8px;font-size:.9rem}
.states{background:var(--white);border-top:4px solid var(--red)}
.states .row{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:.75rem 0}
.swatches{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem}
.sw{border:1px solid var(--line);border-radius:8px;overflow:hidden;font-size:.8rem}.sw div{height:56px}.sw p{margin:0;padding:.5rem}
.focus-demo{outline:3px solid var(--focus);outline-offset:3px}
.sticky-cta{display:none}
@media (max-width:960px){
  .hero .wrap{grid-template-columns:1fr}
  .keyfacts{grid-template-columns:1fr 1fr;margin-top:1rem}
  .keyfacts div:nth-child(2){border-right:0}.keyfacts div:nth-child(-n+2){border-bottom:1px solid var(--line)}
  .grid-3{grid-template-columns:1fr 1fr}
  .steps,.trust{grid-template-columns:1fr 1fr}
  .event{grid-template-columns:auto 1fr}.event .btn{grid-column:1/-1}
  footer.site .wrap{grid-template-columns:1fr 1fr}
}
@media (max-width:1080px){
  .menu-toggle{display:inline-flex;align-items:center;justify-content:center}
  nav.primary{display:none;position:absolute;left:0;right:0;top:100%;background:#fff;padding:1rem;border-bottom:1px solid var(--line);box-shadow:0 20px 30px rgba(0,0,0,.15)}
  nav.primary.open{display:block;height:calc(100dvh - 88px - 76px);max-height:calc(100dvh - 88px - 76px);overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding-bottom:1.5rem}
  nav.primary ul{flex-direction:column}
  nav.primary a,nav.primary button{display:flex;padding:.9rem .75rem;font-size:1.05rem;width:100%}
  nav.primary .sub{position:static;box-shadow:none;border:0;display:block;padding-left:1rem;background:var(--paper)}
  .header-cta .btn-ghost{display:none}
}
@media (max-width:720px){
  body{font-size:16px;padding-bottom:80px}
  .header-cta{display:none}
  .grid-3,.steps,.trust,.dual{grid-template-columns:1fr}
  .deadline{grid-template-columns:1fr}
  .event{grid-template-columns:1fr;text-align:left}.event .date{width:max-content}
  footer.site .wrap{grid-template-columns:1fr}
  .hero h1{max-width:none}
  .sticky-cta{display:flex;position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);padding:.6rem 1rem;gap:.5rem;z-index:60;box-shadow:0 -6px 20px rgba(0,0,0,.08)}
  .sticky-cta .btn{flex:1}
}
@media (max-width:720px){.proto-bar{bottom:88px}}
body.menu-open .proto-bar{display:none!important}
body.menu-open{overflow:hidden}
.nav-backdrop{position:fixed;inset:0;background:rgba(20,39,63,.62);z-index:55;border:0;padding:0;margin:0;cursor:pointer}
.nav-backdrop[hidden]{display:none}
@media (min-width:1081px){.nav-backdrop{display:none!important}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}.card:hover{transform:none}}
.ph img,.photo img{width:100%;height:100%;object-fit:cover;display:block}
.has-img::after{display:none!important}
.pill-closed{background:#E6E1D6;color:#4E607A}
</style>
</head>
<body>
<a class="skip" href="#main">Bỏ qua đến nội dung chính · Skip to content</a>

<div class="util"><div class="wrap">
  <span>{site.hours} · {site.campus}, {site.address.split(",")[0]} · <a href={"tel:"+site.phoneTel}>{site.phone}</a></span>
  <span class="lang"><a href="#" aria-current="true" lang="vi">Tiếng Việt</a><a href="#" lang="en">English</a></span>
</div></div>

<header class="site"><div class="wrap">
  <a class="brand" href="#" aria-label="Trường Việt Ngữ Hùng Vương – trang nhà"><span class="logo-bg"><img src={logo} alt="" width="272" height="54"></span></a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" onclick="toggleMenu(this)">☰ Menu</button>
  <nav class="primary" id="primary-nav" aria-label="Chính"><ul>
    <li><button aria-expanded="false">Chương trình ▾</button><ul class="sub"><li><a href="#">Cấp 1 (MG–lớp 5)</a></li><li><a href="#">Cấp 2 (lớp 6–9)</a></li><li><a href="#">Người lớn</a></li><li><a href="#">Lớp nào phù hợp?</a></li></ul></li>
    <li><button aria-expanded="false">Ghi danh ▾</button><ul class="sub"><li><a href="#">Học sinh mới</a></li><li><a href="#">Học sinh cũ (có số danh bạ)</a></li><li><a href="#">Học phí &amp; hạn chót</a></li><li><a href="#">Hỏi &amp; Trả lời</a></li></ul></li>
    <li><button aria-expanded="false">Sinh hoạt ▾</button><ul class="sub"><li><a href="#">Lịch trình {r.year}</a></li><li><a href="#">Sự kiện</a></li><li><a href="#">Dạ tiệc 40 năm</a></li><li><a href="#">Tin tức</a></li></ul></li>
    <li><button aria-expanded="false">Cộng đồng ▾</button><ul class="sub"><li><a href="#">Hội Phụ Huynh</a></li><li><a href="#">Tình nguyện · Phụ giáo</a></li><li><a href="#">Cựu học sinh</a></li><li><a href="#">Lịch sử &amp; Kỷ yếu</a></li></ul></li>
    <li><a href="#">Giới thiệu</a></li>
    <li><a href="#">Liên lạc</a></li>
  </ul></nav>
  <div class="header-cta"><a class="btn btn-ghost" href="#" style="min-height:44px">Ủng hộ</a><a class="btn btn-primary" href="#" style="min-height:44px">Ghi danh</a></div>
</div></header>
<button class="nav-backdrop" id="navBackdrop" hidden aria-label="Đóng menu" onclick="closeMenu()"></button>

<main id="main">
<section class="hero">
  <div class="wrap">
    <div>
      {r.open ? <span class="pill pill-open">● Ghi danh {r.year} đang mở</span> : <span class="pill pill-closed">Ghi danh {r.year} đã đóng</span>}
      <h1 style="margin-top:.75rem">Lớp tiếng Việt cho các em <em>mỗi sáng Chủ nhật</em> tại Houston</h1>
      <p class="lead">Từ Mẫu giáo đến lớp 9, và lớp người lớn. Thầy cô tình nguyện, 40 năm kinh nghiệm, ngay tại HCC Central. <span lang="en">Vietnamese language &amp; culture classes for kids, teens and adults — Sundays 9–12 at HCC Central.</span></p>
      <div class="actions"><a class="btn btn-primary" href="#">Ghi danh ngay · Enroll now</a><a class="btn btn-secondary" href="#">Xem chương trình</a></div>
    </div>
    <div class={"photo"+(site.heroImage?" has-img":"")} style={site.heroImage?`background-image:url(${base+site.heroImage});background-size:cover;background-position:center`:""} role="img" aria-label="Ảnh học sinh trong lớp (placeholder)"></div>
  </div>
</section>

<div class="wrap">
  <div class="keyfacts" aria-label="Thông tin nhanh">
    <div><span>Khi nào</span><b>{site.hours}</b></div>
    <div><span>Ở đâu</span><b>HCC Central · {site.room}</b></div>
    <div><span>Học phí</span><b>${r.earlyPrice} sớm · ${r.latePrice} sau 1/7</b></div>
    <div><span>Khai giảng</span><b>{r.openingDayLong}</b></div>
  </div>
</div>

<section style="padding-top:2rem">
  <div class="wrap">
    <div class="deadline" role="region" aria-label="Hạn ghi danh">
      <div><strong style="font-size:1.1rem">Ghi danh sớm để được ưu tiên xếp lớp</strong>
        <ol><li><b>${r.earlyPrice}</b> — ghi danh trước {r.earlyDeadline}</li><li><b>${r.latePrice}</b> — {r.lateWindow}</li><li>Khai giảng <b>{r.openingDay}</b> · Học sinh cũ cần số danh bạ</li></ol>
        <span lang="en" style="font-size:.9rem;color:var(--ink-2)">Early-bird ${r.earlyPrice} before June 30; ${r.latePrice} July 1–Aug 14.</span></div>
      <a class="btn btn-primary" href="#">Bắt đầu ghi danh</a>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><div><span class="eyebrow">Chương trình</span><h2>Chọn lớp theo tuổi và trình độ</h2><p>Chưa chắc lớp nào? Trả lời 3 câu hỏi để biết lớp gợi ý, hoặc chọn "thi xếp lớp" khi ghi danh.</p></div><a class="btn btn-secondary" href="#">Lớp nào phù hợp?</a></div>
    <div class="grid-3">
{programs.map(p => { const [cls,label] = statusLabel[p.data.status]; return (<article class="card"><div class="ph">{p.data.image ? <img src={base+p.data.image} alt="" loading="lazy"/> : "[PLACEHOLDER ảnh " + p.data.title + "]"}</div><div class="body"><h3>{p.data.title}</h3><span class="meta">{p.data.meta}</span><ul>{p.data.bullets.map(x => <li>{x}</li>)}</ul><div class="foot"><span class={"pill "+cls}>{label}</span><a href="#">Chi tiết →</a></div></div></article>); })}
    </div>
  </div>
