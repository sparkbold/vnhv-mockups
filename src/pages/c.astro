---
import { loadData, statusLabel, fmtDate } from '../lib/data';
const { site, programs, gala, testimonials, news } = await loadData();
const r = site.registration; const g = gala.data; const gBody = gala.body;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); const logo = base + site.logo;
---
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VNHV Direction C — Bold Modern Rebuild</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
<style is:global>
:root{
  --ink:#14273F; --ink-2:#1F3A5F; --ink-3:#4E607A; --red:#2E7D4F; --red-hover:#256A42; --gold:#C39120; --gold-text:#7A5A12; --jade:#2E7D4F;
  --paper:#F7F3EA; --paper-2:#EFE9DA; --white:#FFFDF8; --line:#D9D1BF; --focus:#1D4ED8;
  --display:"Lora",Georgia,"Times New Roman",serif; --font:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box}
html{color-scheme:light}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.65}
body.in-frame .proto{display:none}
img{max-width:100%;display:block}
a{color:var(--red)}
:focus-visible{outline:3px solid var(--focus);outline-offset:3px;border-radius:2px}
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:#fff;padding:.6rem 1rem;z-index:100}.skip:focus{left:8px}
.wrap{width:min(1240px,100% - 2rem);margin-inline:auto}
h1,h2,h3{font-family:var(--display);line-height:1.12;text-wrap:balance;margin:0;font-weight:600}
h2{font-size:clamp(1.9rem,1.3rem + 2.2vw,3rem)}
.eyebrow{font-family:var(--font);font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--gold-text)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;white-space:nowrap;min-height:52px;padding:.8rem 1.6rem;border-radius:2px;font:inherit;font-weight:600;text-decoration:none;border:2px solid transparent;cursor:pointer;transition:background .15s,color .15s,transform .15s}
.btn-primary{background:var(--red);color:#fff}
.btn-primary:hover{background:var(--red-hover)}
.btn-primary:active{transform:translateY(1px)}
.btn-ink{background:var(--ink);color:#fff}.btn-ink:hover{background:#0F1E33}
.btn-outline{border-color:var(--ink);color:var(--ink);background:transparent}.btn-outline:hover{background:var(--ink);color:#fff}
.btn-outline-light{border-color:#fff;color:#fff;background:transparent}.btn-outline-light:hover{background:#fff;color:var(--ink)}
.btn[aria-disabled="true"]{background:#A9A297;color:#fff;cursor:not-allowed}
/* header */
header.site{background:var(--ink);color:#fff;position:sticky;top:0;z-index:80}
header.site .wrap{display:flex;align-items:center;gap:1.5rem;min-height:80px}
.brand{display:flex;align-items:center;gap:.9rem;text-decoration:none;color:#fff}
.brand img{height:40px;width:auto}
.brand small{display:block;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:#B9C6D8}
nav.primary{margin-left:auto}
nav.primary ul{list-style:none;margin:0;padding:0;display:flex;gap:.25rem}
nav.primary a,nav.primary button{color:#fff;text-decoration:none;font-weight:500;font-size:.95rem;padding:.6rem .7rem;background:none;border:0;font:inherit;font-weight:500;cursor:pointer;display:inline-flex;gap:.3rem;align-items:center;border-bottom:2px solid transparent}
nav.primary a:hover,nav.primary button:hover{border-bottom-color:var(--gold);color:#F2D58A}
nav.primary li{position:relative}
nav.primary > ul > li > a,nav.primary > ul > li > button{white-space:nowrap}
nav.primary .sub{display:none;position:absolute;top:100%;left:0;background:var(--white);color:var(--ink);min-width:260px;padding:.5rem;border-top:3px solid var(--gold);box-shadow:0 14px 30px rgba(0,0,0,.25);list-style:none;margin:0}
nav.primary li:hover>.sub,nav.primary li:focus-within>.sub{display:block}
nav.primary .sub a{color:var(--ink);display:block;border:0}
nav.primary .sub a:hover{background:var(--paper);color:var(--red)}
.header-cta{display:flex;gap:.5rem}
.lang{font-size:.85rem;color:#B9C6D8;display:flex;gap:.5rem}
.lang a{color:#fff;text-decoration:none}.lang a[aria-current]{color:var(--gold);font-weight:700}
.menu-toggle{display:none;margin-left:auto;background:none;border:2px solid #fff;color:#fff;border-radius:2px;min-width:48px;min-height:48px;font:inherit;font-weight:700;cursor:pointer}
/* hero */
.hero{background:var(--ink);color:#fff;position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:7fr 5fr;gap:2rem;align-items:end;padding:clamp(3rem,7vw,6rem) 0 0}
.hero .kicker{display:flex;align-items:center;gap:.75rem;color:#F2D58A;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.hero .kicker::before{content:"";width:40px;height:2px;background:var(--gold)}
.hero h1{font-size:clamp(2.6rem,1.6rem + 5vw,5.4rem);font-weight:500;margin:1rem 0 1.25rem;max-width:12ch}
.hero h1 em{font-style:italic;color:#F2D58A}
.hero .lead{font-size:1.2rem;color:#D6DEEA;max-width:46ch;margin:0 0 1.75rem}
.hero .actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:3rem}
.hero .photo{aspect-ratio:4/5;background:linear-gradient(160deg,#1F3A5F,#2E7D4F 60%,#C39120);position:relative;border-top:6px solid var(--gold)}
.hero .photo::after{content:"[PLACEHOLDER: ảnh chân dung học sinh áo dài · dọc 4:5 · cần giấy đồng ý]";position:absolute;left:1rem;right:1rem;bottom:1rem;background:rgba(20,39,63,.8);font-size:.75rem;padding:.4rem .6rem}
.hero .ticker{border-top:1px solid #2F5384;background:#0F1E33}
.hero .ticker .wrap{display:grid;grid-template-columns:repeat(4,1fr);padding:0}
.hero .ticker div{padding:1.1rem 1.25rem 1.1rem 0;border-right:1px solid #2F5384;font-size:.95rem}
.hero .ticker div+div{padding-left:1.25rem}
.hero .ticker div:last-child{border-right:0}
.hero .ticker span{display:block;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:#9DB0C8;font-weight:700}
/* sections */
section{padding:clamp(3rem,7vw,5.5rem) 0}
.sec-head{display:grid;grid-template-columns:auto 1fr auto;gap:1.5rem;align-items:end;margin-bottom:2.25rem}
.sec-head .n{font-family:var(--display);font-style:italic;color:var(--gold-text);font-size:1.1rem;padding-bottom:.4rem}
.sec-head p{margin:.5rem 0 0;color:var(--ink-3);max-width:58ch}
.rule{height:1px;background:var(--line)}
.programs{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);background:var(--white)}
.programs article{padding:2rem;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:.75rem;transition:background .15s}
.programs article:last-child{border-right:0}
.programs article:hover{background:var(--paper)}
.programs .age{font-family:var(--display);font-size:2.4rem;color:var(--ink-2);line-height:1;font-variant-numeric:tabular-nums}
.programs h3{font-size:1.4rem}
.programs p{margin:0;color:var(--ink-3)}
.programs a{margin-top:auto;font-weight:700;text-decoration:none;padding-top:1rem;border-top:1px solid var(--line)}
.programs a:hover{text-decoration:underline}
/* bilingual */
.bi{display:grid;grid-template-columns:1fr 1fr;gap:3rem}
.bi div{position:relative;padding-left:1.25rem;border-left:3px solid var(--gold)}
.bi .tag{display:block;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-text);font-weight:700;margin-bottom:.5rem}
.bi p{font-family:var(--display);font-size:1.25rem;margin:0;color:var(--ink-2)}
/* timeline */
.timeline{background:var(--ink);color:#fff}
.timeline ol{list-style:none;margin:2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);position:relative}
.timeline ol::before{content:"";position:absolute;left:0;right:0;top:9px;height:1px;background:#3A5A85}
.timeline li{padding:2rem 1.25rem 0 0;position:relative}
.timeline li::before{content:"";position:absolute;top:4px;left:0;width:11px;height:11px;border-radius:50%;background:var(--gold)}
.timeline b{font-family:var(--display);font-size:2rem;display:block;color:#F2D58A;font-variant-numeric:tabular-nums;line-height:1}
.timeline p{margin:.4rem 0 0;color:#B9C6D8;font-size:.95rem}
.timeline .now b{color:#fff}
/* event */
.event{display:grid;grid-template-columns:5fr 7fr;background:var(--white);border:1px solid var(--line)}
.event .poster{background:linear-gradient(160deg,#14273F,#1F3A5F 60%,#7A5A12);color:#fff;padding:2.5rem;display:flex;flex-direction:column;justify-content:space-between;min-height:340px}
.event .poster b{font-family:var(--display);font-size:2rem;font-weight:500;line-height:1.1}
.event .poster small{font-size:.75rem;color:#B9C6D8}
.event .body{padding:2.5rem;display:flex;flex-direction:column;gap:1rem}
.event dl{display:grid;grid-template-columns:auto 1fr;gap:.3rem 1.25rem;margin:0}
.event dt{font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);font-weight:700;padding-top:.25rem}.event dd{margin:0}
/* voices */
.voices{display:grid;grid-template-columns:2fr 1fr 1fr;gap:1.5rem}
.voice{background:var(--white);border:1px solid var(--line);padding:2rem;display:flex;flex-direction:column;gap:1rem}
.voice.big{background:var(--ink);color:#fff;border:0}
.voice p{font-family:var(--display);font-size:1.2rem;margin:0;font-style:italic}
.voice.big p{font-size:1.7rem;font-weight:500}
.voice footer{font-size:.9rem;color:var(--ink-3);margin-top:auto}
.voice.big footer{color:#B9C6D8}
/* dual cta */
.dual{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line)}
.dual div{padding:2.5rem;display:flex;flex-direction:column;gap:.75rem}
.dual .give{background:var(--ink-2);color:#fff}
.dual .give .btn{background:#fff;color:var(--ink-2)}
.dual .vol{background:var(--white)}
.dual h3{font-size:1.7rem}.dual p{margin:0}
/* footer */
footer.site{background:var(--ink);color:#B9C6D8;font-size:.95rem;border-top:6px solid var(--gold)}
footer.site .wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:2rem;padding:3.5rem 0 2rem}
footer.site h3{color:#fff;font-family:var(--font);font-size:.78rem;margin-bottom:.9rem;text-transform:uppercase;letter-spacing:.16em}
footer.site a{color:#fff}
footer.site ul{list-style:none;padding:0;margin:0;display:grid;gap:.45rem}
footer.site .legal{border-top:1px solid #3A5A85;padding:1rem 0;font-size:.85rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
/* forms */
.field{display:grid;gap:.35rem;margin-bottom:1rem}
.field label{font-weight:600}
.field input{font:inherit;padding:.7rem .8rem;border:2px solid #7C766A;border-radius:2px;min-height:48px;background:#fff}
.field input:focus{outline:3px solid var(--focus);outline-offset:2px}
.field.error input{border-color:var(--red)}
.field .err{color:var(--red);font-size:.9rem;font-weight:600}
.field .hint{font-size:.85rem;color:var(--ink-3)}
/* proto */
.proto-bar{position:fixed;right:1rem;bottom:1rem;z-index:200}
.proto-bar button{background:var(--ink);color:#fff;border:0;border-radius:999px;padding:.6rem 1rem;font:inherit;font-weight:600;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.25)}
.proto-panel{position:fixed;inset:0;background:rgba(20,39,63,.88);z-index:190;display:grid;place-items:center;padding:1rem}
.proto-panel[hidden]{display:none}
.proto-panel iframe{width:390px;height:min(820px,92vh);border:10px solid #14273F;border-radius:32px;background:#fff}
.proto-note{background:#FFF7DB;border:1px dashed var(--gold-text);padding:.75rem 1rem;font-size:.9rem}
.states{background:var(--white);border-top:4px solid var(--gold)}
.states .row{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:.75rem 0}
.swatches{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem}
.sw{border:1px solid var(--line);overflow:hidden;font-size:.8rem}.sw div{height:56px}.sw p{margin:0;padding:.5rem}
.focus-demo{outline:3px solid var(--focus);outline-offset:3px}
.sticky-cta{display:none}
@media (max-width:1000px){
  .hero .wrap{grid-template-columns:1fr}.hero .photo{aspect-ratio:16/9;max-height:320px}
  .hero .ticker .wrap{grid-template-columns:1fr 1fr}.hero .ticker div{border-bottom:1px solid #2F5384}
  .programs{grid-template-columns:1fr}.programs article{border-right:0;border-bottom:1px solid var(--line)}
  .bi{grid-template-columns:1fr}
  .timeline ol{grid-template-columns:1fr 1fr}.timeline ol::before{display:none}
  .event{grid-template-columns:1fr}
  .voices{grid-template-columns:1fr}
  footer.site .wrap{grid-template-columns:1fr 1fr}
  .sec-head{grid-template-columns:1fr;gap:.5rem}
}
@media (max-width:720px){
  body{font-size:16px;padding-bottom:80px}
  .menu-toggle{display:inline-flex;align-items:center;justify-content:center}
  nav.primary{display:none;position:absolute;left:0;right:0;top:100%;background:var(--ink);padding:1rem;border-top:1px solid #2F5384}
  nav.primary.open{display:block;height:calc(100dvh - 88px - 76px);max-height:calc(100dvh - 88px - 76px);overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding-bottom:1.5rem}
  nav.primary ul{flex-direction:column}
  nav.primary a,nav.primary button{display:flex;padding:.9rem .5rem;font-size:1.05rem;width:100%}
  nav.primary .sub{position:static;box-shadow:none;background:#1A3355;border-top:0;padding-left:1rem}
  nav.primary .sub a{color:#fff}
  .header-cta,.lang{display:none}
  .brand small{display:none}
  .hero h1{max-width:none}
  .dual{grid-template-columns:1fr}
  footer.site .wrap{grid-template-columns:1fr}
  .sticky-cta{display:flex;position:fixed;left:0;right:0;bottom:0;background:var(--ink);padding:.6rem 1rem;gap:.5rem;z-index:60}
  .sticky-cta .btn{flex:1}
}
@media (max-width:720px){.proto-bar{bottom:88px}}
body.menu-open .proto-bar{display:none!important}
body.menu-open{overflow:hidden}
.nav-backdrop{position:fixed;inset:0;background:rgba(20,39,63,.62);z-index:55;border:0;padding:0;margin:0;cursor:pointer}
.nav-backdrop[hidden]{display:none}
@media (min-width:1081px){.nav-backdrop{display:none!important}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.ph img,.photo img{width:100%;height:100%;object-fit:cover;display:block}
.has-img::after{display:none!important}
.pill-closed{background:#E6E1D6;color:#4E607A}
</style>
</head>
<body>
<a class="skip" href="#main">Bỏ qua đến nội dung chính</a>

<header class="site"><div class="wrap">
  <a class="brand" href="#" aria-label="Trường Việt Ngữ Hùng Vương – trang nhà"><img src={logo} alt="" width="272" height="54"><span><small>Houston · từ 1986</small></span></a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" onclick="toggleMenu(this)">☰ Menu</button>
  <nav class="primary" id="primary-nav" aria-label="Chính"><ul>
    <li><button aria-expanded="false">Chương trình ▾</button><ul class="sub"><li><a href="#">Cấp 1 · Mẫu giáo–lớp 5</a></li><li><a href="#">Cấp 2 · lớp 6–9</a></li><li><a href="#">Người lớn</a></li></ul></li>
    <li><a href="#">Ghi danh</a></li>
    <li><button aria-expanded="false">Sinh hoạt ▾</button><ul class="sub"><li><a href="#">Lịch trình {r.year}</a></li><li><a href="#">Sự kiện · Tin tức</a></li><li><a href="#">Hình ảnh</a></li></ul></li>
    <li><button aria-expanded="false">Cộng đồng ▾</button><ul class="sub"><li><a href="#">Hội Phụ Huynh</a></li><li><a href="#">Tình nguyện · Phụ giáo</a></li><li><a href="#">Cựu học sinh</a></li><li><a href="#">40 năm · Kỷ yếu</a></li></ul></li>
    <li><a href="#">Giới thiệu</a></li>
    <li><a href="#">Liên lạc</a></li>
  </ul></nav>
  <span class="lang"><a href="#" aria-current="true" lang="vi">VI</a>|<a href="#" lang="en">EN</a></span>
  <div class="header-cta"><a class="btn btn-primary" href="#" style="min-height:44px">Ghi danh</a></div>
</div></header>
<button class="nav-backdrop" id="navBackdrop" hidden aria-label="Đóng menu" onclick="closeMenu()"></button>

<main id="main">
<section class="hero" style="padding:0">
  <div class="wrap">
    <div>
      <p class="kicker">Trường Việt Ngữ Hùng Vương · 1986–2026</p>
      <h1>Tiếng Việt còn, <em>người Việt còn.</em></h1>
      <p class="lead">Bốn mươi năm dạy tiếng Việt và văn hoá Việt cho các thế hệ tại Houston — mỗi sáng Chủ nhật, do các thầy cô tình nguyện. <span lang="en">Vietnamese language &amp; culture for children, teens and adults, every Sunday at HCC Central.</span></p>
      <div class="actions"><a class="btn btn-primary" href="#">Ghi danh niên khóa {r.year}</a><a class="btn btn-outline-light" href="#">Vé Dạ tiệc 40 năm</a></div>
    </div>
    <div class={"photo"+(site.heroImage?" has-img":"")} style={site.heroImage?`background-image:url(${base+site.heroImage});background-size:cover;background-position:center`:""} role="img" aria-label="Ảnh học sinh (placeholder)"></div>
  </div>
  <div class="ticker"><div class="wrap">
    <div><span>Giờ học</span>{site.hours}</div>
    <div><span>Địa điểm</span>HCC Central · {site.room}</div>
    <div><span>Học phí {r.year}</span>${r.earlyPrice} trước 30/6 · ${r.latePrice} sau</div>
    <div><span>Khai giảng</span>{r.openingDayLong}</div>
  </div></div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><span class="n">Chương trình</span><div><h2>Ba lớp, một buổi sáng</h2><p>Mỗi cấp lớp là một niên khóa. Các lớp đông được chia theo tuổi và trình độ; học xong lớp 9 được cấp bằng tốt nghiệp.</p></div><a class="btn btn-outline" href="#">Lớp nào phù hợp?</a></div>
    <div class="programs">
{programs.map(p => (<article><span class="age">{p.data.ages}</span><h3>{p.data.title}</h3><p>{p.body}</p><a href="#">Xem chương trình {p.data.title.replace("Việt ngữ ","")} →</a></article>))}
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap"><div class="rule" style="margin-bottom:3rem"></div>
    <div class="bi">
      <div lang="vi"><span class="tag">Thông điệp</span><p>{site.messageVi}</p></div>
      <div lang="en"><span class="tag">Our message</span><p>{site.messageEn}</p></div>
    </div>
  </div>
</section>

<section class="timeline">
  <div class="wrap">
    <span class="eyebrow" style="color:#F2D58A">Hành trình 40 năm</span>
    <h2 style="margin-top:.5rem">Một ngôn ngữ · Một văn hoá · Muôn thế hệ</h2>
    <ol>
{site.timeline.map((t,i) => (<li class={i===site.timeline.length-1?"now":""}><b>{t.year}</b><p>{t.text}</p></li>))}
    </ol>
    <p style="margin:2rem 0 0"><a href="#" style="color:#F2D58A;font-weight:600">Xem kỷ yếu và hình ảnh 1986–2026 →</a></p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><span class="n">Sự kiện</span><div><h2>Dạ tiệc Kỷ niệm 40 năm</h2></div><a href="#" style="font-weight:600">Lịch sinh hoạt →</a></div>
    <div class="event">
      <div class="poster"><small>Thứ Bảy · 24 tháng 10, 2026</small><b>Hành Trình 40 Năm<br>Một Ngôn Ngữ – Một Văn Hoá<br>Muôn Thế Hệ</b><small>[PLACEHOLDER: poster / logo 40 năm hiện có trên site]</small></div>
      <div class="body">
        <dl><dt>Giờ</dt><dd>5:00 – 11:00 tối</dd><dt>Nơi</dt><dd>{g.venue}, {g.address}</dd><dt>Vé</dt><dd>{g.prices}</dd><dt>Chương trình</dt><dd>{gBody}</dd><dt>Liên lạc</dt><dd><a href={"mailto:"+g.contactEmail}>{g.contactEmail}</a></dd></dl>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-top:auto"><a class="btn btn-primary" href={g.ticketUrl}>Mua vé trên Zeffy</a><a class="btn btn-outline" href="#">Tải poster (PDF)</a></div>
      </div>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap">
    <div class="sec-head"><span class="n">Tiếng nói</span><div><h2>Các em nói về việc học tiếng Việt</h2></div><a href="#" style="font-weight:600">15 chia sẻ →</a></div>
    <div class="voices">
